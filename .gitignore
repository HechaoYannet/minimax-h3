# Python
__pycache__/
*.py[cod]

# Text-embedding cache -- content-addressed, regenerate in ~12 s, 25 MB each
cache/text_embed/

# Run logs (keep the tree readable; the README/NOTES carry the conclusions)
workspace/*/run*.log

# Generated media.  These are deliverables, not source: 4 MB each and
# regenerable from the committed prompt + reference image, so they stay out
# of history rather than bloating every future clone.
workspace/*/outputs/*.mp4

# WSL/Windows interop droppings (the models directory gets these on copy)
*:Zone.Identifier

# Local scratch
*.tmp
.DS_Store

# Sweep results are regenerated by scripts/h3_sweep.py and are large; the README
# quotes the numbers that matter.
cache/sweep/
workspace/_instr*.py

# Test outputs (quality ladder + reference-modality smoke tests).  Regenerable
# from the committed prompt + materials; the README quotes the metrics.
workspace/*/quality/
workspace/*/outputs/refmodes/

# Windows-visible staging copy of the model weights (27 GB).  docker/run.ps1
# mounts this into the container; the copy WSL itself uses lives in
# ~/source/minimax-h3/models and is the authoritative one.
/models/

# Build-context artifacts and exported image tars (see docker/):
#   vendor/ is regenerated by docker/prepare-context.sh
#   out/    is where pack-usb.ps1 writes the image tar
docker/vendor/
docker/out/
